{
  "version": 1.0,
  "metadata": {
    "name": "@wm_signature_26_name",
    "id": "26",
    "description": "signature_3",
    "reminder_not_support_mode": ["multi", "raw", "200m", "doc", "pano", "mimoji", "instant"],
    "exclude_cases": ["200m"],
    "priority": 3
  },
  "layout_group": [
    {
      "layout": [
        {
          "type": "Layout",
          "id": "all_content",
          "orientation": "horizontal",
          "layout_width": "wrap_content",
          "layout_height": "wrap_content",
          "gravity": "center",
          "margin_left": "0dp",
          "margin_top": "0dp",
          "background": "@background=white",
          "background_optional": true,
          "childViews": [
            {
              "type": "Layout",
              "id": "left_padding",
              "orientation": "horizontal",
              "layout_width": "240dp",
              "layout_height": "match_parent",
              "gravity": "left",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "childViews": []
            },
            {
              "type": "Layout",
              "id": "content_layout",
              "orientation": "vertical",
              "layout_width": "wrap_content",
              "layout_height": "wrap_content",
              "gravity": "center",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "childViews": [
                {
                  "type": "Layout",
                  "id": "top_padding",
                  "orientation": "horizontal",
                  "layout_width": "match_parent",
                  "layout_height": "240dp",
                  "gravity": "left",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "childViews": []
                },
                {
                  "type": "ImageView",
                  "id": "src_image_view",
                  "layout_gravity": "left",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "display_height": "0dp",
                  "path": ""
                },
                {
                  "type": "Layout",
                  "id": "watermark_content",
                  "orientation": "none",
                  "layout_width": "match_parent",
                  "layout_height": "640dp",
                  "gravity": "center",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "childViews": [
                    {
                      "type": "Layout",
                      "id": "watermark_group",
                      "orientation": "vertical",
                      "layout_width": "wrap_content",
                      "layout_height": "wrap_content",
                      "gravity": "center",
                      "margin_left": "0dp",
                      "margin_top": "0dp",
                      "childViews": [
                        {
                          "type": "Layout",
                          "id": "logo_model_space_signature",
                          "orientation": "vertical",
                          "layout_width": "wrap_content",
                          "layout_height": "wrap_content",
                          "gravity": "center_horizontal",
                          "margin_left": "0dp",
                          "margin_top": "0dp",
                          "childViews": [
                            {
                              "type": "Layout",
                              "id": "brand_space_layout1",
                              "orientation": "horizontal",
                              "layout_width": "match_parent",
                              "layout_height": "wrap_content",
                              "gravity": "center_vertical",
                              "margin_left": "0dp",
                              "margin_top": "15dp",
                              "childViews": []
                            },
                            {
                              "type": "Layout",
                              "id": "logo_model_signature",
                              "orientation": "horizontal",
                              "layout_width": "wrap_content",
                              "layout_height": "wrap_content",
                              "gravity": "center_horizontal",
                              "margin_left": "0dp",
                              "margin_top": "0dp",
                              "childViews": [
                                {
                                  "type": "Layout",
                                  "id": "brand_layout",
                                  "orientation": "horizontal",
                                  "layout_width": "wrap_content",
                                  "layout_height": "wrap_content",
                                  "gravity": "left|center_vertical",
                                  "margin_left": "0dp",
                                  "margin_top": "0dp",
                                  "childViews": [
                                    {
                                      "type": "ImageView",
                                      "id": "logo",
                                      "layout_gravity": "center_vertical",
                                      "margin_left": "0dp",
                                      "margin_top": "0dp",
                                      "display_height": "40dp",
                                      "display_width": "0dp",
                                      "path": "pathType=fill;path=${logo};foreground=3"
                                    },
                                    {
                                      "type": "TextView",
                                      "id": "model",
                                      "margin_left": "0dp",
                                      "layout_gravity": "center_vertical",
                                      "text": "@model= @{series}@{versionNumber}",
                                      "text_upper": false,
                                      "font_ref": "f1"
                                    },
                                    {
                                      "type": "TextView",
                                      "id": "model_versionName",
                                      "margin_left": "0dp",
                                      "layout_gravity": "center_vertical",
                                      "text": "@model=@{versionName}",
                                      "text_upper": false,
                                      "font_ref": "f3",
                                      "rect_params": {
                                        "rect_text_width_gap": 9,
                                        "rect_text_height_gap": 0,
                                        "rect_line_width": 2,
                                        "rect_radius": [7, 7, 7, 7, 7, 7, 7, 7],
                                        "rect_line_color": "@foreground=2",
                                        "rect_width": "wrap_content",
                                        "rect_height": "30dp"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "type": "Layout",
                                  "id": "custom_signature_layout",
                                  "orientation": "horizontal",
                                  "layout_width": "wrap_content",
                                  "layout_height": "wrap_content",
                                  "gravity": "center_vertical",
                                  "margin_left": "0dp",
                                  "margin_top": "0dp",
                                  "optional": true,
                                  "setting_optional_type": "type_custom_signature",
                                  "childViews": [
                                    {
                                      "type": "Layout",
                                      "id": "line_layout",
                                      "orientation": "horizontal",
                                      "layout_width": "2dp",
                                      "layout_height": "36dp",
                                      "background": "@foreground=1",
                                      "gravity": "center_vertical",
                                      "margin_left": "20dp",
                                      "margin_top": "0dp",
                                      "childViews": []
                                    },
                                    {
                                      "type": "ImageView",
                                      "id": "custom_signature",
                                      "layout_gravity": "center_vertical",
                                      "margin_left": "20dp",
                                      "margin_top": "0dp",
                                      "display_height": "40dp",
                                      "display_width": "0dp",
                                      "path": "pathType=select;path=icon_signature;foreground=3"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "Layout",
                              "id": "brand_space_layout2",
                              "orientation": "horizontal",
                              "layout_width": "match_parent",
                              "layout_height": "wrap_content",
                              "gravity": "center_vertical",
                              "margin_left": "0dp",
                              "margin_top": "15dp",
                              "childViews": []
                            }
                          ]
                        },
                        {
                          "type": "TextView",
                          "id": "exif",
                          "optional": true,
                          "margin_top": "6dp",
                          "layout_gravity": "center_horizontal",
                          "text": "@exif=@{focal}mm  f/@{aperture}  @{speed}s  ISO@{iso}",
                          "font_ref": "f2"
                        },
                        {
                          "type": "TextView",
                          "id": "location",
                          "optional": true,
                          "margin_top": "6dp",
                          "layout_gravity": "center_horizontal",
                          "text": "@location=location_latlng;@locationLimit=0.8",
                          "font_ref": "f2"
                        },
                        {
                          "type": "TextView",
                          "id": "time",
                          "optional": true,
                          "layout_gravity": "center_horizontal",
                          "margin_left": "0dp",
                          "margin_top": "6dp",
                          "text": "@time=@wm_time_yyyy_MM_dd_HH_mm",
                          "font_ref": "f2"
                        },
                        {
                          "type": "TextView",
                          "id": "custom_text",
                          "optional": true,
                          "layout_gravity": "center_horizontal",
                          "margin_left": "0dp",
                          "margin_top": "6dp",
                          "text": "@custom=0.4",
                          "font_ref": "f2"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "Layout",
              "id": "right_padding",
              "orientation": "horizontal",
              "layout_width": "240dp",
              "layout_height": "match_parent",
              "gravity": "left",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "childViews": []
            }
          ]
        }
      ]
    }
  ],
  "wmRes": {
    "background": [
      {
        "name": "white",
        "icon": "@img=icon_background_white.webp",
        "value": "@color=#FFFFFFFF",
        "foreground": ["#FF000000", "#4D000000", "#BF000000", "black", "#99000000"]
      },
      {
        "name": "black",
        "icon": "@img=icon_background_black.webp",
        "value": "@color=#FF141414",
        "foreground": ["#FFFFFFFF", "#4DFFFFFF", "#BFFFFFFF", "white", "#99FFFFFF"]
      },
      {
        "name": "light_blur",
        "icon": "@img=icon_background_light_blur.webp",
        "value": "@algo=light_blur",
        "foreground": ["#FF000000", "#4D000000", "#BF000000", "black", "#99000000"]
      },
      {
        "name": "dark_blur",
        "icon": "@img=icon_background_dark_blur.webp",
        "value": "@algo=dark_blur",
        "foreground": ["#FFFFFFFF", "#4DFFFFFF", "#BFFFFFFF", "white", "#99FFFFFF"]
      }
    ],
    "fonts": {
      "f1": {
        "size": 36.0,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 501"
      },
      "f2": {
        "size": 20.0,
        "color": "@foreground=4",
        "typeface": "default",
        "variation": "'wght' 400",
        "letterSpacing": 0.187
      },
      "f3": {
        "size": 20.0,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 451",
        "letterSpacing": 0.04
      }
    }
  }
}