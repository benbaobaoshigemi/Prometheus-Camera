{
  "version": 1.78,
  "metadata": {
    "name": "@name",
    "id": "116",
    "description": "2025_spring_festival_116",
    "reminder_not_support_mode": ["multi", "raw", "200m", "doc", "pano", "mimoji", "instant"],
    "reminder": "@wm_common_reminder_v3",
    "show_in_menu": false,
    "limitation": {
      "custom_not_support": {
        "ro.miui.build.region": ["global"],
        "ro.boot.product.theme_customize": ["lcc"],
        "ro.product.device": [],
        "device_type": []
      }
    },
    "priority": 3,
    "position": "with",
    "exclude_cases": ["200m"],
    "layer_list": ["background", "dynamic_left", "static_content", "src_img", "dynamic_right"],
    "gainmap_modify_version": 1
  },
  "layout_group": [
    {
      "layout": [
        {
          "type": "Layout",
          "id": "all_content",
          "gainmap_value": 100,
          "orientation": "overlap",
          "layout_width": "wrap_content",
          "layout_height": "wrap_content",
          "gravity": "center",
          "margin_left": "0dp",
          "margin_top": "0dp",
          "background": "@background=fireworks",
          "background_optional": true,
          "childViews":[
            {
              "type": "ImageView",
              "id": "dynamic_left",
              "layout_gravity": "left|bottom",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "display_width": "0dp",
              "display_height": "350dp",
              "layer_group": "dynamic_left",
              "gainmap_value": 100,
              "path": "pathType=select;path=static_left;foreground=3",
              "dynamic_path": "pathType=select;path=dynamic_left;foreground=3"
            },
            {
              "type": "Layout",
              "id": "static_content",
              "orientation": "horizontal",
              "layout_width": "wrap_content",
              "layout_height": "wrap_content",
              "gravity": "center",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "childViews": [
                {
                  "type": "Layout",
                  "id": "left_padding",
                  "orientation": "horizontal",
                  "layout_width": "20dp",
                  "layout_height": "match_parent",
                  "gravity": "left",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "childViews": []
                },
                {
                  "type": "Layout",
                  "id": "content_layout",
                  "orientation": "vertical",
                  "layout_width": "wrap_content",
                  "layout_height": "wrap_content",
                  "gravity": "center",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "childViews": [
                    {
                      "type": "Layout",
                      "id": "top_padding",
                      "orientation": "none",
                      "layout_width": "match_parent",
                      "layout_height": "128dp",
                      "gravity": "left",
                      "margin_left": "0dp",
                      "margin_top": "0dp",
                      "layer_group": "static_content",
                      "childViews": [
                        {
                          "type": "Layout",
                          "id": "brand_layout",
                          "orientation": "horizontal",
                          "layout_width": "wrap_content",
                          "layout_height": "wrap_content",
                          "gravity": "left",
                          "margin_left": "30dp",
                          "margin_top": "58dp",
                          "childViews": [
                            {
                              "type": "ImageView",
                              "id": "logo",
                              "layout_gravity": "center_vertical",
                              "margin_left": "0dp",
                              "margin_top": "0dp",
                              "display_height": "40dp",
                              "display_width": "0dp",
                              "path": "pathType=fill;path=${logo};foreground=2"
                            },
                            {
                              "type": "TextView",
                              "id": "model",
                              "margin_left": "0dp",
                              "layout_gravity": "center_vertical",
                              "text": "@model= @{series}@{versionNumber}",
                              "text_upper": false,
                              "font_ref": "f1"
                            },
                            {
                              "type": "TextView",
                              "id": "model_versionName",
                              "margin_left": "0dp",
                              "layout_gravity": "center_vertical",
                              "text": "@model=@{versionName}",
                              "text_upper": false,
                              "font_ref": "f2",
                              "rect_params": {
                                "rect_text_width_gap": 10,
                                "rect_text_height_gap": 0,
                                "rect_line_width": 2,
                                "rect_radius": [7, 7, 7, 7, 7, 7, 7, 7],
                                "rect_line_color": "@foreground=1",
                                "rect_width": "wrap_content",
                                "rect_height": "32dp"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "ImageView",
                      "id": "src_image_view",
                      "layout_gravity": "left",
                      "margin_left": "0dp",
                      "margin_top": "0dp",
                      "display_height": "0dp",
                      "layer_group": "src_img",
                      "path": ""
                    },
                    {
                      "type": "Layout",
                      "id": "bottom_content_layout",
                      "orientation": "none",
                      "layout_width": "match_parent",
                      "layout_height": "198dp",
                      "gravity": "center",
                      "margin_left": "0dp",
                      "margin_top": "0dp",
                      "layer_group": "static_content",
                      "childViews": [
                        {
                          "type": "Layout",
                          "id": "greeting_mix_layout",
                          "orientation": "vertical",
                          "layout_width": "wrap_content",
                          "layout_height": "wrap_content",
                          "gravity": "left|center_vertical",
                          "margin_left": "30dp",
                          "margin_top": "0dp",
                          "childViews":[
                            {
                              "type": "TextView",
                              "id": "greeting_text",
                              "layout_gravity": "left",
                              "margin_left": "0dp",
                              "margin_top": "0dp",
                              "text": "@greeting=0.4;@defaultText=@wm_default_greeting_text",
                              "font_ref": "f3"
                            },
                            {
                              "type": "TextView",
                              "id": "mix_text_1",
                              "optional": true,
                              "layout_gravity": "left",
                              "margin_left": "0dp",
                              "margin_top": "8dp",
                              "text": "@mix=time;@locationLimit=0.8;@time=@wm_time_yyyy_MM_dd_HH_mm",
                              "font_ref": "f4"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "Layout",
                      "id": "bottom_padding",
                      "orientation": "none",
                      "layout_width": "match_parent",
                      "layout_height": "20dp",
                      "gravity": "center",
                      "margin_left": "0dp",
                      "margin_top": "0dp",
                      "layer_group": "static_content",
                      "childViews": []
                    }
                  ]
                },
                {
                  "type": "Layout",
                  "id": "right_padding",
                  "orientation": "horizontal",
                  "layout_width": "20dp",
                  "layout_height": "match_parent",
                  "gravity": "left",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "childViews": []
                }
              ]
            },
            {
              "type": "ImageView",
              "id": "dynamic_right",
              "layout_gravity": "right|bottom",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "display_width": "0dp",
              "display_height": "420dp",
              "layer_group": "dynamic_right",
              "gainmap_value": 100,
              "path": "pathType=select;path=static_right;foreground=3",
              "dynamic_path": "pathType=select;path=dynamic_right;foreground=3"
            }
          ]
        }
      ]
    }
  ],
  "wmRes": {
    "pre_greeting": ["@wm_pre_greeting_text_1","@wm_pre_greeting_text_2","@wm_pre_greeting_text_3","@wm_pre_greeting_text_4","@wm_pre_greeting_text_5","@wm_pre_greeting_text_6"],
    "dynamic_images": [
      {
        "path": "@img=dynamic_left_fireworks.webp",
        "grid_size": [
          12,
          6
        ],
        "layer_type": "foreground"
      },
      {
        "path": "@img=dynamic_left_tangyuan.webp",
        "grid_size": [
          12,
          6
        ],
        "layer_type": "foreground"
      },
      {
        "path": "@img=dynamic_right_fireworks.webp",
        "grid_size": [
          12,
          3
        ],
        "layer_type": "foreground"
      },
      {
        "path": "@img=dynamic_right_tangyuan.webp",
        "grid_size": [
          12,
          6
        ],
        "layer_type": "foreground"
      }
    ],

    "background": [
      {
        "name": "fireworks",
        "icon": "@img=icon_fireworks.webp",
        "value": "@color=#FF8F0403",
        "value_mivi": "@color=#FF821A11",
        "foreground": ["#FFFFE099", "#FFE3A974", "FFE099", "fireworks"]
      },
      {
        "name": "tangyuan",
        "icon": "@img=icon_tangyuan.webp",
        "value": "@color=#FF8F0403",
        "value_mivi": "@color=#FF821A11",
        "foreground": ["#FFFFE099", "#FFE3A974", "FFE099", "tangyuan"]
      }
    ],
    "fonts": {
      "f1": {
        "size": 35.0,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 501"
      },
      "f2": {
        "size": 22.0,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 451",
        "letterSpacing": 0.04
      },
      "f3": {
        "size": 40.0,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 501",
        "letterSpacing": 0.025
      },
      "f4": {
        "size": 28.0,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 400",
        "letterSpacing": 0.035
      }
    }
  }
}