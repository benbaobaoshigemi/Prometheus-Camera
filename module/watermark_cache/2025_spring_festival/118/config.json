{
  "version": 1.78,
  "metadata": {
    "name": "@name",
    "id": "118",
    "description": "2025_spring_festival_118",
    "reminder_not_support_mode": ["multi", "raw", "200m", "doc", "pano", "mimoji", "instant"],
    "show_in_menu": false,
    "limitation": {
      "custom_not_support": {
        "ro.miui.build.region": ["global"],
        "ro.boot.product.theme_customize": ["lcc"],
        "ro.product.device": [],
        "device_type": []
      }
    },
    "priority": 4,
    "position": "out",
    "exclude_cases": ["200m"]
  },
  "layout_group": [
    {
      "layout": [
        {
          "type": "Layout",
          "id": "all_content",
          "orientation": "vertical",
          "layout_width": "wrap_content",
          "layout_height": "wrap_content",
          "gravity": "center",
          "margin_left": "0dp",
          "margin_top": "0dp",
          "background": "@background=golden",
          "background_optional": true,
          "childViews": [
            {
              "type": "ImageView",
              "id": "src_image_view",
              "layer_group": "src_img",
              "layout_gravity": "left",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "display_height": "0dp",
              "path": ""
            },
            {
              "type": "Layout",
              "id": "bottom_content",
              "orientation": "none",
              "layout_width": "match_parent",
              "layout_height": "180dp",
              "gravity": "left",
              "margin_left": "0dp",
              "margin_top": "0dp",
              "childViews": [
                {
                  "type": "ImageView",
                  "id": "bg_img",
                  "layout_gravity": "center",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "display_height": "match_parent",
                  "display_width": "match_parent",
                  "path": "pathType=select;path=bg;foreground=3"
                },
                {
                  "type": "ImageView",
                  "id": "bottom_center",
                  "layout_gravity": "center",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "display_height": "180dp",
                  "display_width": "0dp",
                  "path": "pathType=select;path=img_bottom_center;foreground=3"
                },
                {
                  "type": "Layout",
                  "id": "left_bottom_group",
                  "orientation": "vertical",
                  "layout_width": "wrap_content",
                  "layout_height": "wrap_content",
                  "gravity": "left|center_vertical",
                  "margin_left": "48dp",
                  "margin_top": "0dp",
                  "childViews": [
                    {
                      "type": "Layout",
                      "id": "brand_layout",
                      "orientation": "horizontal",
                      "layer_group": "bottom_content",
                      "layout_width": "wrap_content",
                      "layout_height": "wrap_content",
                      "gravity": "left|center_vertical",
                      "margin_left": "0dp",
                      "margin_top": "0dp",
                      "childViews": [
                        {
                          "type": "ImageView",
                          "id": "logo",
                          "layout_gravity": "center_vertical",
                          "margin_left": "0dp",
                          "margin_top": "0dp",
                          "display_height": "44dp",
                          "display_width": "0dp",
                          "path": "pathType=fill;path=${logo};foreground=2"
                        },
                        {
                          "type": "TextView",
                          "id": "model",
                          "margin_left": "0dp",
                          "layout_gravity": "center_vertical",
                          "text": "@model= @{series}@{versionNumber}",
                          "text_upper": false,
                          "font_ref": "f1"
                        },
                        {
                          "type": "TextView",
                          "id": "model_versionName",
                          "margin_left": "0dp",
                          "layout_gravity": "center_vertical",
                          "text": "@model=@{versionName}",
                          "text_upper": false,
                          "font_ref": "f2",
                          "rect_params": {
                            "rect_text_width_gap": 8,
                            "rect_text_height_gap": 0,
                            "rect_line_width": 2,
                            "rect_radius": [8.8, 8.8, 8.8, 8.8, 8.8, 8.8, 8.8, 8.8],
                            "rect_line_color": "@foreground=1",
                            "rect_width": "wrap_content",
                            "rect_height": "34dp"
                          }
                        }
                      ]
                    },
                    {
                      "type": "TextView",
                      "id": "greeting_text",
                      "layout_gravity": "left",
                      "margin_left": "0dp",
                      "margin_top": "10dp",
                      "text": "@greeting=0.4;@defaultText=@wm_default_greeting_text",
                      "font_ref": "f3"
                    }
                  ]
                },
                {
                  "type": "ImageView",
                  "id": "bottom_right",
                  "layout_gravity": "right",
                  "margin_left": "0dp",
                  "margin_top": "0dp",
                  "display_height": "180dp",
                  "display_width": "0dp",
                  "path": "pathType=select;path=img_bottom_right;foreground=3"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "wmRes": {
    "pre_greeting": ["@wm_pre_greeting_text_1","@wm_pre_greeting_text_2","@wm_pre_greeting_text_3","@wm_pre_greeting_text_4","@wm_pre_greeting_text_5","@wm_pre_greeting_text_6"],
    "background": [
      {
        "name": "golden",
        "icon": "@img=icon_golden.webp",
        "value": "@color=#00FFFFFF",
        "foreground": ["#FF74380B", "#BF74380B", "74380B", "golden"]
      },
      {
        "name": "red",
        "icon": "@img=icon_red.webp",
        "value": "@color=#FF981725",
        "value_mivi": "@color=#FF8C2529",
        "foreground": ["#FFF6C566", "#BFF6C566", "F6C566", "red"]
      }
    ],
    "fonts": {
      "f1": {
        "size": 39.6,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 500"
      },
      "f2": {
        "size": 24.2,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 450",
        "letterSpacing": 0.082
      },
      "f3": {
        "size": 36,
        "color": "@foreground=0",
        "typeface": "default",
        "variation": "'wght' 450"
      }
    }
  }
}