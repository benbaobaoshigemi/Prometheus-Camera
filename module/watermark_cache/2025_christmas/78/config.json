                                "rect_text_width_gap": 6,
                                "rect_text_height_gap": 4,
                                "rect_line_width": 1.1,
                                "rect_radius": [4, 4, 4, 4, 4, 4, 4, 4],
                                "rect_line_color": "@foreground=4",
                                "rect_width": "wrap_content",
                                "rect_height": "19dp"
                              }

                            }
                          ]
                        },
                        {
                          "type": "Layout",
                          "id": "time_layout",
